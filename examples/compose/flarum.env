MEMORY_LIMIT=256M
UPLOAD_MAX_SIZE=16M
OPCACHE_MEM_SIZE=128
REAL_IP_FROM=0.0.0.0/32
REAL_IP_HEADER=X-Forwarded-For
LOG_IP_VAR=remote_addr

# FoF S3 (optional) — S3 or Cellar; override admin settings when set
# FOF_S3_ACCESS_KEY_ID=
# FOF_S3_SECRET_ACCESS_KEY=
# FOF_S3_REGION=us-east-1
# FOF_S3_BUCKET=your-bucket
# FOF_S3_URL=https://your-bucket.s3.example.com
# FOF_S3_ENDPOINT=https://s3.example.com
# FOF_S3_PATH_STYLE_ENDPOINT=1
