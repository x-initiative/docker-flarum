MEMORY_LIMIT=256M
UPLOAD_MAX_SIZE=16M
OPCACHE_MEM_SIZE=128
REAL_IP_FROM=0.0.0.0/32
REAL_IP_HEADER=X-Forwarded-For
LOG_IP_VAR=remote_addr

# FoF S3 (optional) — S3 or Cellar; override admin settings when set
# Blomstra S3 Assets (Clever Cellar / S3-compatible) — Laravel-style AWS_* vars.
# When AWS_BUCKET is set, the boot script enables blomstra-s3-assets and sets PHP-FPM clear_env=no.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=default
# AWS_BUCKET=your-bucket-name
# AWS_ENDPOINT=https://cellar-c2.services.clever-cloud.com
# AWS_URL=https://your-bucket-name.cellar-c2.services.clever-cloud.com
# AWS_PATH_STYLE_ENDPOINT=true
# AWS_ACL=public-read
